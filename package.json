{
  "name": "minigpt-desktop",
  "version": "0.2.0",
  "productName": "miniGPT",
  "private": true,
  "description": "A Windows ChatGPT companion powered by Codex, with a global shortcut, image chat, local history, and a floating window.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jinrt0517/miniGPT.git"
  },
  "homepage": "https://github.com/Jinrt0517/miniGPT#readme",
  "bugs": {
    "url": "https://github.com/Jinrt0517/miniGPT/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/main.cjs",
  "scripts": {
    "prestart": "node scripts/build-assets.cjs",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/smoke-desktop.cjs",
    "test:clipboard": "node scripts/check-clipboard.cjs",
    "test:chat": "node scripts/check-chat.cjs",
    "test:generation-controls": "node scripts/check-generation-controls.cjs",
    "test:resume-shortcut": "node scripts/check-resume-shortcut.cjs",
    "test:selection-controls": "node scripts/check-selection-controls.cjs",
    "test:welcome-quotes": "node scripts/check-welcome-quotes.cjs",
    "test:window-state": "node scripts/check-window-state.cjs",
    "test:taskbar": "node scripts/check-taskbar.cjs",
    "test:history": "node scripts/check-history-controls.cjs",
    "pretest:rendering": "node scripts/build-assets.cjs",
    "test:rendering": "node scripts/check-rendering.cjs",
    "build:assets": "node scripts/build-assets.cjs",
    "build:native": "node scripts/build-native.cjs",
    "pack": "node scripts/package.cjs"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "dompurify": "^3.2.6",
    "katex": "^0.18.9",
    "marked": "^16.0.0",
    "marked-cjk-friendly": "^0.1.2"
  }
}
